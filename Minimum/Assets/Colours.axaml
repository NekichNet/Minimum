<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key='Dark'>
			<SolidColorBrush x:Key='Background3Brush'>Black</SolidColorBrush>
			<SolidColorBrush x:Key='Background2Brush'>DarkGray</SolidColorBrush>
			<SolidColorBrush x:Key='Background1Brush'>Gray</SolidColorBrush>
			<SolidColorBrush x:Key='Accent1Brush'>LightGreen</SolidColorBrush>
			<SolidColorBrush x:Key='ForegroundBrush'>White</SolidColorBrush>
		</ResourceDictionary>
		<ResourceDictionary x:Key='Light'>
			<SolidColorBrush x:Key='Background3Brush'>White</SolidColorBrush>
			<SolidColorBrush x:Key='Background2Brush'>LightGray</SolidColorBrush>
			<SolidColorBrush x:Key='Background1Brush'>Gray</SolidColorBrush>
			<SolidColorBrush x:Key='Accent1Brush'>Green</SolidColorBrush>
			<SolidColorBrush x:Key='ForegroundBrush'>Black</SolidColorBrush>
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>