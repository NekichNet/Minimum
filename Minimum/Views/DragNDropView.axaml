<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Minimum.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="400"
             x:Class="Minimum.DragNDropView" Background="Transparent" x:DataType="vm:DragNDropViewModel">
    <Grid DragDrop.AllowDrop="True"
          DragDrop.DragEnter="Grid_DragEnter"
          DragDrop.DragLeave="Grid_DragLeave"
          DragDrop.Drop="Grid_Drop">

        <Border Background="{Binding BackgroundColor}" 
                CornerRadius="10" 
                Opacity="0.8"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
            <TextBlock Text="{Binding Text_DragNDropClue}" 
                       FontSize="20" 
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>

</UserControl>
